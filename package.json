{
  "name": "decky-live-translator",
  "version": "0.6.2",
  "description": "Automatic, live translation of any game's on-screen text for Decky Loader (Steam Deck): reads the game's own frames, translates on the device and draws the translation over the original.",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-engine.cjs",
    "build:worker": "node scripts/build-worker.cjs",
    "build": "node scripts/build-worker.cjs && rollup -c",
    "watch": "rollup -c -w",
    "zip": "python scripts/make_zip.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veter1904/decky-live-translator.git"
  },
  "author": "Veter1904",
  "license": "MIT",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "esbuild": "^0.28.2",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tesseract.js": "6.0.1",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
